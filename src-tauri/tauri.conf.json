{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPIA",
  "version": "0.1.4",
  "identifier": "com.spia.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SPIA",
        "width": 480,
        "height": 680,
        "resizable": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {},
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 Illia Nieviezhyn\nhello@nvzhn.com",
    "targets": [
      "dmg",
      "app"
    ],
    "macOS": {
      "dmg": {
        "background": "icons/dmg_background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        }
      }
    },
    "externalBin": [
      "binaries/spia-engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/spia-engine-dist/**/*"
    ]
  }
}